@model IndieVault.DTOs.RecommendationResultDto

@{
    ViewData["Title"] = "Recommended For You";
}

<div class="d-flex flex-wrap justify-content-between align-items-center gap-3 mb-4">
    <div>
        <h1 class="fw-bold mb-1">@ViewData["Title"]</h1>
        @if (Model.Games.Any())
        {
            @if (Model.GeneratedByAi)
            {
                <span class="badge rounded-pill bg-primary px-3 py-2">
                    <i class="bi bi-stars me-1"></i>Picked by AI from games you have not tried
                </span>
            }
            else
            {
                <span class="badge rounded-pill bg-secondary px-3 py-2">
                    <i class="bi bi-controller me-1"></i>Based on your wishlist, downloads and reviews
                </span>
            }
        }
    </div>

    <form asp-controller="Recommendation" asp-action="Refresh" method="post">
        <button type="submit" class="btn btn-outline-light rounded-pill px-4">
            <i class="bi bi-arrow-clockwise me-1"></i>Refresh
        </button>
    </form>
</div>

@if (!Model.Games.Any())
{
    <div class="text-center py-5">
        <i class="bi bi-emoji-smile fs-1"></i>
        <p class="lead mt-3">There is nothing new to recommend right now.</p>
        <a asp-controller="Home" asp-action="Index" class="btn btn-primary">Browse Games</a>
    </div>
}
else
{
    <div class="row row-cols-1 row-cols-sm-2 row-cols-lg-3 g-4">
        @foreach (var item in Model.Games)
        {
            <div class="col d-flex flex-column">
                <partial name="_GameCard" model="item.Game" />
                <p class="small text-muted mt-2 mb-0 px-1">
                    <i class="bi bi-chat-quote me-1"></i>@item.Reason
                </p>
            </div>
        }
    </div>
}
